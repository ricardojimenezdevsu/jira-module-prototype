# Copy to .env. Nothing here is secret.

# App ID from velx-jira-app/manifest.yml. Tokens whose audience is not this app are rejected.
FORGE_APP_ID=ari:cloud:ecosystem::app/74d26b02-8e17-4696-b688-936149961083

# Local port. Point the cloudflared tunnel at it: cloudflared tunnel --url http://localhost:3000
PORT=3000

# Base URL used for "Open in Velx" links. A reserved .example domain: the stub has no real Velx.
VELX_WEB_URL=https://demo.velx.example

# The Velx user every Jira user acts as, until Atlassian-to-Velx user mapping exists (#3755).
VELX_STUB_USERNAME=demo.user

# Enables the "Simulate progress" and "Simulate failure" buttons (stub only).
VELX_SIMULATION=true

# Where issue <-> initiative links live: jira-property (issue property, needs write:jira-work)
# or memory (lost on restart).
LINK_STORE=jira-property
