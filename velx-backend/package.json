{
  "name": "velx-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Stub Velx connector for the Jira prototype. Receives Forge Remote calls, verifies the Forge Invocation Token and reads issues from Jira with the user's token.",
  "type": "module",
  "engines": {
    "bun": ">=1.2"
  },
  "scripts": {
    "start": "bun src/server.ts",
    "dev": "bun --watch src/server.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^5.3.0",
    "jose": "^6.2.18"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/express": "^5.0.0",
    "typescript": "^5.8.0"
  }
}
