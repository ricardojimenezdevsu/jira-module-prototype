{
  "name": "velx-jira-app",
  "version": "1.0.0",
  "private": true,
  "description": "Throwaway Forge prototype: Jira issue-view modules that link issues to Velx initiatives.",
  "scripts": {
    "build": "rm -rf build && bun build ./src/frontend/link-velx-initiative.html ./src/frontend/create-velx-initiative.html ./src/frontend/velx-initiative-status.html ./src/frontend/velx-initiative-panel.html ./src/frontend/velx-journal.html --outdir build --production",
    "watch": "bun build ./src/frontend/link-velx-initiative.html ./src/frontend/create-velx-initiative.html ./src/frontend/velx-initiative-status.html ./src/frontend/velx-initiative-panel.html ./src/frontend/velx-journal.html --outdir build --watch --no-clear-screen",
    "typecheck": "tsc --project src/frontend",
    "lint": "forge lint",
    "deploy": "bun run build && forge deploy"
  },
  "dependencies": {
    "@forge/bridge": "^7.3.0",
    "@forge/react": "^12.5.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "typescript": "^5.8.0"
  }
}
