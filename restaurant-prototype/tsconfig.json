{
  // Only src/ is included: the Forge bundler fails on deploy if tsconfig picks up other folders
  // (static/kitchen-ticket has its own tsconfig). No "noEmit" here: the Forge bundler (ts-loader)
  // needs output; `npm run typecheck` passes --noEmit itself.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true
  },
  "include": ["src"]
}
