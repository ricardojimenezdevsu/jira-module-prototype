{
  "name": "restaurant-prototype",
  "version": "1.0.0",
  "private": true,
  "description": "Throwaway Forge prototype: four Jira issue-view modules with a restaurant theme.",
  "scripts": {
    "build": "rm -rf build && bun build ./src/frontend/send-to-kitchen.html ./src/frontend/table-service.html ./src/frontend/kitchen-ticket.html ./src/frontend/kitchen-log.html --outdir build --production",
    "typecheck": "tsc --project src/frontend",
    "lint": "forge lint",
    "deploy": "bun run build && forge deploy"
  },
  "dependencies": {
    "@forge/bridge": "^7.3.0",
    "@forge/react": "^12.5.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "typescript": "^5.8.0"
  }
}
